# Keep the repository's text files at LF and check them out as LF, so a clone holds exactly the same bytes
# that were verified on the development machine (Git's core.autocrlf would otherwise rewrite them to CRLF).

* text=auto eol=lf

# Batch files run fine with LF in cmd.exe; keep them text so nothing is guessed.
*.cmd text eol=lf
*.bat text eol=lf

# Never touch these.
*.png binary
*.dll binary
